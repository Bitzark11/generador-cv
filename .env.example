# Copia este archivo como ".env" y ajusta los valores.
# El archivo ".env" real NO se sube a GitHub (está en .gitignore).

# Puerto del servidor (Render lo define solo en producción)
PORT=3000

# Sitios autorizados para llamar a la API desde el navegador (CORS).
# Separa varios con comas. En producción: la URL de tu frontend (Netlify/Vercel).
ALLOWED_ORIGIN=http://localhost:3000
